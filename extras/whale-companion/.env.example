# Local preview defaults. Change these for cloud deployment (see docs/DEPLOY.md).
HOST=127.0.0.1
PORT=4318
PUBLIC_URL=http://127.0.0.1:4318
DATA_DIR=./data
# At least 24 characters. If absent on loopback, a random key is saved in .local/admin-key.txt.
ADMIN_KEY=
# demo = explicitly labelled scripted replies; deepseek = real API.
AI_MODE=demo
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Optional host-only DSH status bridge. Generate a restricted key in device settings.
# WHALE_COMPANION_URL=https://your-domain.example
# WHALE_BRIDGE_KEY=
